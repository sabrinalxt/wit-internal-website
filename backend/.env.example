# Copy to backend/.env and fill in. Never commit backend/.env.

# MySQL connection string. Use a throwaway local database.
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/DATABASE_NAME"

# Secret used to sign login tokens. Use a long random string (e.g. `openssl rand -hex 32`).
JWT_SECRET="replace-with-a-long-random-string"

# Optional (defaults shown)
PORT=4000
CORS_ORIGIN="http://localhost:5173"
NODE_ENV=development

# Optional: overrides the dev-only password given to seeded users
# SEED_DEV_PASSWORD="choose-a-dev-password"

# Email
# Defaults to console in development and smtp in production.
EMAIL_PROVIDER=console
EMAIL_FROM="WIT Internal <no-reply@example.com>"
# APP_URL="http://localhost:5173"

# Required when EMAIL_PROVIDER=smtp
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER="your-smtp-user"
# SMTP_PASS="your-smtp-password"
