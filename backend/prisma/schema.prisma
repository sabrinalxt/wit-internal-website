generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Enums
enum RoleName {
  Requestor
  PillarLead
  Approver
  Admin
  Viewer
}

enum ProposalType {
  IPA
  FA
}

enum ProposalStatus {
  DRAFT
  SUBMITTED
  PILLAR_APPROVED
  APPROVED
  REJECTED
}

// Models
model User {
  user_id       Int      @id @default(autoincrement())
  first_name    String   @db.VarChar(100)
  last_name     String   @db.VarChar(100)
  email         String   @unique @db.VarChar(255)
  // Null until the user signs up (pre-created users have no password yet)
  password_hash String?  @db.Char(60)
  created_at    DateTime @default(now())

  user_roles               UserRole[]
  proposals_as_requestor   Proposal[] @relation("Requestor")
  proposals_as_pillar_lead Proposal[] @relation("PillarLead")
  proposals_as_approver    Proposal[] @relation("Approver")
  templates                Template[]
  events                   Event[]
  accesses                 Access[]
  views                    View[]
}

model Role {
  role_id   Int      @id @default(autoincrement())
  role_name RoleName @unique

  user_roles UserRole[]
}

model UserRole {
  id      Int @id @default(autoincrement())
  user_id Int
  role_id Int

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  role Role @relation(fields: [role_id], references: [role_id], onDelete: Cascade)

  @@unique([user_id, role_id])
}

model Proposal {
  proposal_id        Int            @id @default(autoincrement())
  proposal_name      String         @db.VarChar(255)
  proposal_type      ProposalType
  proposal_status    ProposalStatus @default(DRAFT)
  drive_link         String?        @db.VarChar(512)
  rejection_reason   String?        @db.Text
  date_submitted     DateTime?      @db.Timestamp(0)
  date_reviewed      DateTime?      @db.Timestamp(0)
  requestor_id       Int
  // Reviewers are chosen per proposal
  pillar_lead_id     Int?
  approver_id        Int?
  // An FA links to its IPA (rule enforced in the app, not the DB)
  parent_proposal_id Int?

  requestor   User       @relation("Requestor", fields: [requestor_id], references: [user_id])
  pillar_lead User?      @relation("PillarLead", fields: [pillar_lead_id], references: [user_id])
  approver    User?      @relation("Approver", fields: [approver_id], references: [user_id])
  parent      Proposal?  @relation("ProposalParent", fields: [parent_proposal_id], references: [proposal_id], onDelete: Restrict)
  children    Proposal[] @relation("ProposalParent")
  events      Event[]

  @@index([requestor_id])
  @@index([pillar_lead_id])
  @@index([approver_id])
  @@index([parent_proposal_id])
}

model Template {
  template_id   Int     @id @default(autoincrement())
  template_name String  @db.VarChar(255)
  template_type String? @db.VarChar(50)
  content_link  String? @db.VarChar(512)
  admin_id      Int

  admin    User     @relation(fields: [admin_id], references: [user_id])
  accesses Access[]
  views    View[]

  @@index([admin_id])
}

model Event {
  event_id    Int       @id @default(autoincrement())
  event_name  String    @db.VarChar(255)
  event_date  DateTime? @db.Date
  pillar      String?   @db.VarChar(100)
  proposal_id Int
  admin_id    Int

  proposal       Proposal       @relation(fields: [proposal_id], references: [proposal_id])
  admin          User           @relation(fields: [admin_id], references: [user_id])
  event_contacts EventContact[]
  views          View[]

  @@index([proposal_id])
  @@index([admin_id])
}

model NetworkContact {
  network_contact_id          Int     @id @default(autoincrement())
  network_contact_name        String  @db.VarChar(255)
  network_contact_email       String? @unique @db.VarChar(255)
  network_contact_association String? @db.VarChar(255)
  pillar_interest             String? @db.VarChar(100)

  event_contacts EventContact[]
}

model EventContact {
  id                        Int     @id @default(autoincrement())
  event_id                  Int
  contact_id                Int
  event_contact_association String? @db.VarChar(255)

  event   Event          @relation(fields: [event_id], references: [event_id], onDelete: Cascade)
  contact NetworkContact @relation(fields: [contact_id], references: [network_contact_id], onDelete: Cascade)

  @@unique([event_id, contact_id])
  @@index([contact_id])
}

model Access {
  id          Int @id @default(autoincrement())
  user_id     Int
  template_id Int

  user     User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  template Template @relation(fields: [template_id], references: [template_id], onDelete: Cascade)

  @@unique([user_id, template_id])
  @@index([template_id])
}

model View {
  id          Int  @id @default(autoincrement())
  user_id     Int
  event_id    Int
  template_id Int?

  user     User      @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  event    Event     @relation(fields: [event_id], references: [event_id], onDelete: Cascade)
  template Template? @relation(fields: [template_id], references: [template_id], onDelete: Cascade)

  @@unique([user_id, event_id, template_id])
  @@index([event_id])
  @@index([template_id])
}
